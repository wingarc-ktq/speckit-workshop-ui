{
  "name": "speckit-workshop-ui",
  "private": false,
  "version": "1.0.0",
  "description": "Modern React + TypeScript + Material-UI web application with authentication, internationalization, testing, and Figma MCP integration",
  "keywords": [
    "react",
    "typescript",
    "material-ui",
    "vite",
    "tanstack-query",
    "msw",
    "figma-mcp",
    "i18n",
    "authentication",
    "clean-architecture",
    "playwright",
    "e2e",
    "testing",
    "mcp",
    "ai-assisted"
  ],
  "author": "nakai95",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wingarc-ktq/speckit-workshop-ui.git"
  },
  "homepage": "https://github.com/wingarc-ktq/speckit-workshop-ui#readme",
  "bugs": {
    "url": "https://github.com/wingarc-ktq/speckit-workshop-ui/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc --project tsconfig.app.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest related --run",
    "test:e2e": "playwright test --config=playwright/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=playwright/playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config=playwright/playwright.config.ts --headed",
    "test:e2e:chromium": "playwright test --config=playwright/playwright.config.ts --project=chromium",
    "test:e2e:firefox": "playwright test --config=playwright/playwright.config.ts --project=firefox",
    "test:e2e:webkit": "playwright test --config=playwright/playwright.config.ts --project=webkit",
    "test:e2e:mobile": "playwright test --config=playwright/playwright.config.ts --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:report": "playwright show-report playwright/playwright-report",
    "test:e2e:install": "playwright install --with-deps",
    "gen:api": "orval --config ./schema/orval.config.ts",
    "msw:init": "msw init public/ --save"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.10.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "date-fns": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "orval": "^8.20.0",
    "prettier": "^3.9.4",
    "react-i18next": "^17.0.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6"
    }
  }
}
